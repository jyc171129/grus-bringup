# Xiaomi Mi 9 SE (grus) 的 U-Boot 默认环境
#
# 以 board/qualcomm/qcom-phone.env 为底（qcom_defconfig + qcom-phone.config 通用那套），
# 加上 grus 自己的内存地址与菜单。sirius.env 里那套 mmcblk0pNN 的分区引用不能照抄：
# grus 是 UFS，在 U-Boot 里枚举成 SCSI，而且分区号完全不同。
#
# 第一阶段（U-Boot 自己起来看到菜单 / 进 fastboot）只用到下面的 fastboot 与菜单部分；
# 分区相关的 TODO 等 GPT 读出来再补。

bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# ---- 加载地址 ----
# 6 GiB 机型，base 0x80000000；这几个地址沿用 sirius（同一平台、同一内存图）。
# 0x80080000 起 是 U-Boot 自己（u-boot-nodtb.bin.gz + dtb 被 ABL 装在这里），
# 所以 kernel/ramdisk/fdt 都从它之后开始放。
kernel_addr_r=0x80080000
ramdisk_addr_r=0x83000000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000
pxefile_addr_r=0x82800000

# ---- fastboot ----
# 由 ABL 以 boot.img 形式装载，跑起来后把 USB 切成 fastboot gadget。
# 这里刻意跟 sirius.env 一样只写 `fastboot usb 0`：之前写的
# `fastboot -l $fastboot_addr_r usb 0` 里那个变量根本没定义，展开后
# 变成 `fastboot -l usb 0`，"-l" 会把 "usb" 当成下载地址吃掉，命令直接失败。
fastboot=fastboot usb 0

# ---- 根设备与 blkmap ----
# UFS 在 U-Boot 里是 scsi 0；没有 UFS 时才退回 mmc 0。
setup_rootdev=if scsi device 0; then setenv rootdev scsi 0; else mmc rescan; setenv rootdev mmc 0; fi
setup_blkmap=part start ${rootdev} userdata userdata_start; part size ${rootdev} userdata userdata_size; blkmap create root; blkmap map root 0 0x${userdata_size} linear ${rootdev} 0x${userdata_start}

# UFS 必须先扫出来，fastboot 才看得到分区（getvar partition-size:* 才有东西）。
# 没有 UFS 时退回 mmc 0，让 fastboot 至少有个块设备可用。
# 注意：任何一步卡住都会表现为"USB 直接消失"，跟 U-Boot 没启动一样，
# 所以要靠 fastboot devices 里的序列号来判断当前到底跑的是谁
# （ABL 是 98b40243，U-Boot 是 "?"）。
#
# 每条命令前面都打一个 ###Dx 标记：这台机器没有串口，唯一的输出通道是
# `fastboot oem console` 拉回来的环形缓冲，前后文里全是 dwc3 的刷屏噪音，
# 没有标记根本分不清哪一行是谁说的。顺序按"最安全 -> 最碰硬件"排。
#
# dm tree 已经从 diag 里去掉：它一个人就占 400 多行，把 128 KB 的环形缓冲冲掉大半，
# 而它要回答的问题（UFS 有没有 probe 上）看 scsi scan 两行就够了。
diag=echo '###D1-CLK'; clk dump; echo '###D2-UFS-INIT'; ufs init; echo '###D3-SCSI-SCAN'; scsi scan; echo '###D5-PART'; part list scsi 0; echo '###D6-DIAG-END'

# ---- misc / BCB ----
# 2026-11-06 实测结论，两条都反了，记在这里免得再试：
#
#   1. 写 "boot-recovery" 时，ABL 回 recovery 分区（所以以前的死循环是它造成的）。
#   2. 写 "bootonce-bootloader" 时，ABL **不进 fastboot**，而是当普通启动去开
#      boot 分区（MIUI），结果卡在 Mi logo。
#
# 也就是说这颗 ABL 并不按 AOSP 那套 BCB 语义走，「靠 BCB 让机器自己回 fastboot」
# 这条路已经不成立，别再加码。U-Boot 的复位/重启入口一律不再使用：
# 真正要做的是让 U-Boot 自己会刷分区（fb_mmc 的 scsi 回退），
# 这样刷 payload 根本不需要回到 ABL。
#
# 现在 preboot 只做一件事：把 BCB 清空。留着一个 ABL 不认的命令值既没用又危险，
# 清掉之后机器至少能正常起 Android。
misc_clear=echo '###D7-MISC'; grus_misc show; grus_misc clear

# ---- FAT 读回测试（S1 判据）----
# 分工定下来了，写在这里免得下次又走回头路：
#
#   大文件永远走 ABL。实测 U-Boot 的 dwc3 gadget 在 64 MiB 的 download 上
#   直接 data transfer failure，之后 gadget 卡死（usb 上只剩 ????????????，
#   oem console 也发不出去，只能物理断电）。这不是分区访问的问题——scsi 回退
#   修好之后 getvar partition-size:* 全部正常——是 gadget 本身的带宽/队列问题。
#
#   所以 payload 的载体是一个 FAT 镜像，由 ABL 用 `fastboot flash cache` 灌进
#   cache 分区（256 MiB，start LBA 147456，U-Boot 分区号 27），U-Boot 只负责
#   挂上它把文件读出来。镜像由 probe-grus/mkfat.py 生成，不依赖任何外部工具。
#
# 测试文件固定用 cache 分区根目录下的 HELLO.TXT（47 B，纯文本，md 输出肉眼可读）
# 和 BLOB.BIN（300000 B = 0x493E0，跨 74 个簇，用来验证长链）。
#
# 分区号一律写名字，不写序号。实测 `scsi 0:27` 会被解析成**十六进制** 0x27=39，
# 报 "** Invalid partition 39 **"；而 27 十进制是 0x1b，序号和写法的对应关系
# 很容易错一次，用 `0:cache` 由 U-Boot 自己去 GPT 里按名字查，永远不会错位。
fatdiag=echo '###F1-FATLS'; fatls scsi 0:cache; echo '###F2-FATLOAD'; fatload scsi 0:cache 0x82000000 HELLO.TXT; echo '###F3-MD-TEXT'; md.b 0x82000000 0x30; echo '###F4-FATLOAD-BLOB'; fatload scsi 0:cache 0x84000000 BLOB.BIN; echo '###F5-CRC32'; crc32 0x84000000 0x493E0; echo '###F6-FAT-END'

# LUN0 上没有 boot/system/vendor 这些分区，它们应该在 LUN4（5.8 GB）上。
# 这一步只是把 LUN4 的 GPT 打出来登记一下，为以后放 payload 做参考，
# 不参与 FAT 测试。
lunsurvey=echo '###L1-LUN4-PART'; part list scsi 4; echo '###L2-LUN-END'

# fatdiag 放在最后：它依赖 scsi 已经被 diag 扫出来，而且读错分区只会报错不会
# 碰坏东西，所以就算 cache 还没灌镜像，也只是多几行错误，不影响进 fastboot。
preboot=run diag; run misc_clear; run fatdiag; run lunsurvey

# 串口 gadget：屏幕和控制台同时可用，方便在没串口针脚的机器上抓日志
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; setenv bootretry -1; echo Enabled U-Boot console serial gadget

# 一起来就无条件进 fastboot，不等菜单、不做任何探测。
# 原因：这台机器屏幕上能看到的信息太少，而 fastboot gadget 一旦起来，
# USB 上就会枚举出一个设备——这是唯一不需要人肉观察屏幕的确定性信号。
# 认到之后再用 `fastboot getvar all` / `fastboot oem` 把环境问出来。
# 想进菜单：按住音量下开机（button_cmd_0 见文件末尾）。
bootcmd=run fastboot

menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=Enable fastboot mode=run fastboot
bootmenu_1=Enable serial console gadget=run serial_gadget
bootmenu_2=SCSI / UFS scan=scsi scan; scsi info; part list ${rootdev}; pause
bootmenu_3=Dump clocks=clk dump; pause
bootmenu_4=Dump environment=printenv; pause
bootmenu_5=Board info=bdinfo; pause
bootmenu_6=Drop to shell=setenv bootretry -1
bootmenu_7=Reset device=reset

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
