# grus deltas on top of qcom_defconfig + qcom-phone.config.
# Applied as a kconfig fragment: make qcom_defconfig qcom-phone.config grus.config
#
# 与 sirius.config 逐行相同 —— 板级差异全在 dts 和 env 里，不在 Kconfig。
# 保留单独一份文件是为了将来 grus 需要额外开关（比如 UFS 相关）时不用改别人的板子。
CONFIG_BLKMAP=y
# qcom-phone.config 里是 0x6000（24 KB）。实测这远远不够：fastboot gadget 一起来，
# dwc3 会以约 4 KB/s 的速度刷 "c0 was not queued to ep1in-bulk"，几秒就把环形缓冲
# 覆盖干净，`fastboot oem console` 拉回来的只有刷屏噪音，preboot 里 scsi scan 的
# 报错全被冲掉。128 KB 大约能留 30 秒余量，足够在设备枚举出来后立刻回读。
# 再翻一倍到 256 KB：efi_selftest 一次要吐上千行，加上它前面的诊断，128 KB 会被
# 挤掉开头。2 GiB 内存不在乎这 128 KB。
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x40000
CONFIG_CMD_BLKMAP=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/xiaomi/grus/grus.env"
CONFIG_CMD_SYSBOOT=y
CONFIG_CMD_BCB=y
CONFIG_SYS_CBSIZE=1024
CONFIG_EFI_LOADER=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BINARY=y
CONFIG_CMD_BOOTEFI_BOOTMGR=y
# UniXNU 要经由 UEFI 起来，所以 bootefi 是这条链的最后一颗螺丝。在用真正的
# payload 之前，先用 U-Boot 自带的 efi_selftest 验一遍：它把 EFI 引导服务、
# 内存映射、事件定时器、协议安装全部走一遍，跑得通就说明"能在这颗 SoC 上执行
# EFI 镜像"，跑不通就是 EFI 层本身的问题，和 XNU 无关。
# 这一条只多 30 KB 左右的代码，换掉一整轮"怀疑是 payload 不对"的排查。
CONFIG_CMD_BOOTEFI_SELFTEST=y
# HakiOS 的两个开关（board/xiaomi/grus/hakios/ 里的补丁，源自 oosexgang/hakios-uefi @1c65228
# 的 u-boot/，基线同为 U-Boot v2026.07，可直接打）：
#   CMD_HAKIOS           把内存里的 payload 搬到 0xF0000000，再 bootefi 起 loader.efi
#   EFI_QCOM_USB_DEVICE  给 U-Boot 补上高通私有的 EFI_USB_DEVICE_PROTOCOL，
#                        hackios 的 loader 靠它跟主机对话（xl enter/ramdisk/log）
CONFIG_CMD_HAKIOS=y
CONFIG_EFI_QCOM_USB_DEVICE=y
